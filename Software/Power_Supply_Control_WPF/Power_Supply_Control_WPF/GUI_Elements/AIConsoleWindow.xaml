<Window x:Class="Power_Supply_Control_WPF.GUI_Elements.AIConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Power_Supply_Control_WPF.GUI_Elements"
        mc:Ignorable="d"
        Title="AIConsoleWindow" Height="1024" Width="1820">
    <Grid Background="LightSteelBlue">
        <Grid.Resources>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        </Grid.Resources>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Message History Console -->
        <ListBox x:Name="MessageHistory" Grid.Row="0" Margin="10" FontSize="14" Background="WhiteSmoke" BorderBrush="LightSalmon" BorderThickness="1.5"/>

        <!-- Input Area -->
        <DockPanel Grid.Row="1" Margin="10,0,10,10">
            <Button x:Name="SendButton" Content="Send" DockPanel.Dock="Right" Width="75" Padding="5" Margin="10,0,0,0" Click="SendButton_Click" BorderBrush="LightSalmon"/>
            <ToggleButton x:Name="MicButton" Content="🎙" FontSize="14" FontWeight="Bold" Click="MicButton_Click" BorderBrush="LightSalmon" Padding="5" Margin="0,0,5,0"/>
            <ProgressBar x:Name="VolumeMeter" Grid.Row="1" Minimum="0" Maximum="100" Value="5" Foreground="Green" Background="#FFE0E0E0" Margin="5,0,5,0" MinWidth="5"/>
            <Grid>
                <TextBox x:Name="InputTextBox" FontSize="14" Padding="5" VerticalContentAlignment="Center" KeyDown="InputTextBox_KeyDown" BorderBrush="LightSalmon" BorderThickness="1.5"/>
                <TextBlock Text="Enter a prompt for the LLM or click the microphone button for speech to text." Visibility="{Binding ElementName=InputTextBox, Path=Text.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}}" Opacity="0.6" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Margin="8,0,0,0"/>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
