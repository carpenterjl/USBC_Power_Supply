<Window x:Class="Power_Supply_Control_WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Power_Supply_Control_WPF"
        xmlns:rotaryKnob="clr-namespace:Power_Supply_Control_WPF.GUI_Elements"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:ScottPlot="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        mc:Ignorable="d"
        WindowStyle="None"
        StateChanged="Window_StateChanged"
        Title="MainWindow" MinHeight="724" MinWidth="1843" WindowStartupLocation="CenterScreen">
    
    <!-- Main Form Grid Layout -->
    <Grid Background="#FF2F3136">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        
        <!-- Connect button, Combobox, Titlebar -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>
            <Rectangle Grid.Row="0" Grid.Column="0" Fill="#FF474A52"/>
            <Rectangle x:Name="titleBar" Grid.Row="0" Grid.Column="1" Fill="#FF474A52" MouseDown="titleBar_MouseDown"/>
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width=".85*"/>
                    <ColumnDefinition Width=".05*"/>
                    <ColumnDefinition Width=".05*"/>
                    <ColumnDefinition Width=".05*"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="buttonExit" Grid.Column="3" Margin="5" Background="Tomato" Content="&#xE8BB;" FontSize="32" FontFamily="Segoe MDL2 Assets" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Click="buttonExit_Click"/>
                <Button x:Name="buttonMaximize" Grid.Column="2" Margin="5" Background="AliceBlue" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="32" VerticalContentAlignment="Center" Click="buttonMaximize_Click"/>
                <Button x:Name="buttonMinimize" Grid.Column="1" Margin="5" Background="AliceBlue" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="32" VerticalContentAlignment="Center" Click="buttonMinimize_Click"/>
            </Grid>

            <Button Command="{Binding ConnectToTarget}" Grid.Row="0" Grid.Column="0" Width="120" Margin="5" HorizontalAlignment="Left" FontSize="16" ToolTip="Connect to target device.">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DeviceConnectedStatus}" Value="True">
                                <Setter Property="Content" Value="Disconnect"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding DeviceConnectedStatus}" Value="False">
                                <Setter Property="Content" Value="Connect"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <ComboBox Name="comboBoxPortsList" Width="200" Height="30" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="5" ToolTip="COM Port Selection for Power Supply serial communication." Text="{Binding SelectedPortName}"/>
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Select the COM port below." Foreground="Snow" FontSize="16" HorizontalAlignment="Right" Margin="5" VerticalAlignment="Top"/>
        </Grid>
        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="USBC Power Supply V1.0" FontSize="27.75" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <!-- Panels for controls and measurements -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>

            <!-- V_Positive Controls Cell -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.3*"/>
                </Grid.RowDefinitions>
                <Rectangle Fill="#FF474A52"/>
                <TextBlock Text="V_Positive" Foreground="Snow" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Grid Grid.Row= "1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.6*" MinWidth="200"/>
                        <ColumnDefinition Width="0.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Block -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.2*"/>
                            <RowDefinition Height="0.4*"/>
                            <RowDefinition Height="0.4*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>

                        <CheckBox Name="adjVP" Content="Adjust&#10;Limits" Foreground="Snow" VerticalAlignment="Center" Margin="5"/>

                        <TextBlock Grid.Row="1" Text="Upper" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <xctk:DoubleUpDown Grid.Row="1" MinHeight="20" MinWidth="60" Minimum="0" Maximum="20" FormatString="F3" Value="{Binding Voltage_Positive_Limit_High}" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=adjVP}"/>

                        <TextBlock Grid.Row="2" Text="Lower" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <xctk:DoubleUpDown Grid.Row="2" MinHeight="20" MinWidth="60" Minimum="0" Maximum="20" FormatString="F3" Value="{Binding Voltage_Positive_Limit_Low}" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=adjVP}"/>

                        <Button Name="VPADJ_DOWN" Grid.Row="3" Margin="10" Background="#FF474A52" BorderBrush="Snow" MinWidth="40" ToolTip="Decrease V_Positive (Towards 0V)">
                            <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="5" MinWidth="25" Fill="Snow"/>
                        </Button>
                    </Grid>

                    <!-- Center Block -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.1*"/>
                            <RowDefinition Height="0.8*"/>
                            <RowDefinition Height="0.1*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status:" FontSize="16" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="0" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,30,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VPEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="Lime"/>
                                            <Setter Property="Text" Value="On"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VPEnabled}" Value="False">
                                            <Setter Property="Foreground" Value="Red"/>
                                            <Setter Property="Text" Value="Off"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Rectangle Width="10" Height="10" RadiusX="5" RadiusY="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VPEnabled}" Value="True">
                                            <Setter Property="Fill" Value="Lime"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VPEnabled}" Value="False">
                                            <Setter Property="Fill" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <rotaryKnob:RotaryKnob x:Name="VPKnob" Grid.Row="1" MinWidth="150" MinHeight="150" Minimum="0" Maximum="20" Value="{Binding Voltage_Positive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Command="{Binding ToggleVPCommand}"  Grid.Row="2" Margin="2" Content="Toggle" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" ToolTip="Toggle Supply On/Off."/>
                    </Grid>

                    <!-- Right Block -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="1" Margin="10" Background="#FF474A52" BorderBrush="Snow" ToolTip="Set V_Positive Voltage." Command="{Binding SetPositiveSupply}">
                            <Grid >
                                <TextBlock Text="Set" FontSize="16" Foreground="Snow"/>
                            </Grid>
                        </Button>
                        <Button Name="VPADJ_UP" Grid.Row="2" Margin="10" Background="#FF474A52" BorderBrush="Snow" MinWidth="40" ToolTip="Increase V_Positive (Towards 20V)">
                            <Grid>
                                <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="5" MinWidth="25" Fill="Snow"/>
                                <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="25" MinWidth="5" Fill="Snow"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <Slider Grid.Row="2" Height="10" VerticalAlignment="Top" Margin="10" Background="AliceBlue" BorderBrush="Lime" BorderThickness="1" Value="{Binding Voltage_Positive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="0" Maximum="20"/>
                <TextBox Grid.Row="2" Height="50" VerticalAlignment="Center" Margin="15" FontSize="36" Text="{Binding Voltage_Positive, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/>
                <CheckBox IsChecked="{Binding plotPositive.VoltageTrace.Visible}" Name="LogVoltageP" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Voltage" Foreground="Snow" Margin="5"/>
                <CheckBox IsChecked="{Binding plotPositive.CurrentTrace.Visible}" Name="LogCurrentP" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Current" Foreground="Snow" Margin="5" HorizontalAlignment="Center"/>
                <CheckBox IsChecked="{Binding plotPositive.PowerTrace.Visible}" Name="LogPowerP" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Power" Foreground="Snow" Margin="5" HorizontalAlignment="Right"/>
                
                <ScottPlot:WpfPlot Name="VPPlot" Grid.Row="3" Margin="5" BorderBrush="Lime" BorderThickness="1"/>
            </Grid>

            <!-- V_Negative Controls Cell -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.3*"/>
                </Grid.RowDefinitions>
                <Rectangle Fill="#FF474A52"/>
                <TextBlock Text="V_Negative" Foreground="Snow" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Grid Grid.Row= "1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.6*" MinWidth="200"/>
                        <ColumnDefinition Width="0.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Block -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.2*"/>
                            <RowDefinition Height="0.4*"/>
                            <RowDefinition Height="0.4*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>

                        <CheckBox Name="adjVN" Content="Adjust&#10;Limits" Foreground="Snow" VerticalAlignment="Center" Margin="5"/>

                        <TextBlock Grid.Row="1" Text="Upper" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <xctk:DoubleUpDown Grid.Row="1" MinHeight="20" MinWidth="60" Minimum="-20" Maximum="0" FormatString="F3" Value="{Binding Voltage_Negative_Limit_High}" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=adjVN}"/>

                        <TextBlock Grid.Row="2" Text="Lower" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <xctk:DoubleUpDown Grid.Row="2" MinHeight="20" MinWidth="60" Minimum="-20" Maximum="0" FormatString="F3" Value="{Binding Voltage_Negative_Limit_Low}" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="{Binding IsChecked, ElementName=adjVN}"/>

                        <Button Grid.Row="3" Margin="10" Background="#FF474A52" BorderBrush="Snow" MinWidth="40" ToolTip="Decrease V_Negative (Towards -20V)">
                            <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="5" MinWidth="25" Fill="Snow"/>
                        </Button>
                    </Grid>

                    <!-- Center Block -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.1*"/>
                            <RowDefinition Height="0.8*"/>
                            <RowDefinition Height="0.1*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status:" FontSize="16" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="0" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,30,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VNEnabled}" Value="True">
                                            <Setter Property="Foreground" Value="Lime"/>
                                            <Setter Property="Text" Value="On"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VNEnabled}" Value="False">
                                            <Setter Property="Foreground" Value="Red"/>
                                            <Setter Property="Text" Value="Off"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Rectangle Width="10" Height="10" RadiusX="5" RadiusY="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VNEnabled}" Value="True">
                                            <Setter Property="Fill" Value="Lime"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding VNEnabled}" Value="False">
                                            <Setter Property="Fill" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <rotaryKnob:RotaryKnob x:Name="VNKnob" Grid.Row="1" MinWidth="150" MinHeight="150" Minimum="-20" Maximum="0" Flipped="True" Value="{Binding Voltage_Negative, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button Command="{Binding ToggleVNCommand}" Grid.Row="2" Margin="2" Content="Toggle" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" ToolTip="Toggle Supply On/Off."/>
                    </Grid>
                    
                    <!-- Right Block -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="0.5*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>
                        <Button Grid.Row="1" Margin="10" Background="#FF474A52" BorderBrush="Snow" ToolTip="Set V_Negative Voltage." Command="{Binding SetNegativeSupply}">
                            <Grid >
                                <TextBlock Text="Set" FontSize="16" Foreground="Snow"/>
                            </Grid>
                        </Button>
                        <Button Grid.Row="2" Margin="10" Background="#FF474A52" BorderBrush="Snow" MinWidth="40" ToolTip="Increase V_Negative (Towards 0V)">
                            <Grid>
                                <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="5" MinWidth="25" Fill="Snow"/>
                                <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="25" MinWidth="5" Fill="Snow"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <Slider Grid.Row="2" Height="10" VerticalAlignment="Top" Margin="10" Background="AliceBlue" BorderBrush="Lime" BorderThickness="1" FlowDirection="RightToLeft" Value="{Binding Voltage_Negative, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="-20" Maximum="0"/>
                <TextBox Grid.Row="2" Height="50" VerticalAlignment="Center" Margin="15" FontSize="36" Text="{Binding Voltage_Negative, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat=F3}"/>
                <CheckBox IsChecked="{Binding plotNegative.VoltageTrace.Visible}" Name="LogVoltageN" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Voltage" Foreground="Snow" Margin="5"/>
                <CheckBox IsChecked="{Binding plotNegative.CurrentTrace.Visible}" Name="LogCurrentN" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Current" Foreground="Snow" Margin="5" HorizontalAlignment="Center"/>
                <CheckBox IsChecked="{Binding plotNegative.PowerTrace.Visible}" Name="LogPowerN" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Power" Foreground="Snow" Margin="5" HorizontalAlignment="Right"/>
                
                <ScottPlot:WpfPlot Name="VNPlot" Grid.Row="3" Margin="5" BorderBrush="Lime" BorderThickness="1"/>
            </Grid>

            <!-- V_3V3 Controls Cell -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.3*"/>
                </Grid.RowDefinitions>
                <Rectangle Fill="#FF474A52"/>
                <TextBlock Text="3V3" Foreground="Snow" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Grid Grid.Row= "1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.6*" MinWidth="200"/>
                        <ColumnDefinition Width="0.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Block -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.2*"/>
                            <RowDefinition Height="0.4*"/>
                            <RowDefinition Height="0.4*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>

                        <CheckBox Content="Adjust&#10;Limits" Foreground="Snow" VerticalAlignment="Center" Margin="5" IsEnabled="False" ToolTip="Control disabled. Fixed Supply."/>

                        <TextBlock Grid.Row="1" Text="Upper" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <xctk:DoubleUpDown Grid.Row="1" MinHeight="20" MinWidth="60" Minimum="0" Maximum="20" FormatString="F3" Value="0" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False" ToolTip="Control disabled. Fixed Supply."/>

                        <TextBlock Grid.Row="2" Text="Lower" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <xctk:DoubleUpDown Grid.Row="2" MinHeight="20" MinWidth="60" Minimum="0" Maximum="20" FormatString="F3" Value="0" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False" ToolTip="Control disabled. Fixed Supply."/>

                        <Button Grid.Row="3" Margin="10" Background="#FF474A52" BorderBrush="Snow" MinWidth="40" IsEnabled="False" ToolTip="Control disabled. Fixed Supply.">
                            <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="5" MinWidth="25" Fill="Snow"/>
                        </Button>
                    </Grid>

                    <!-- Center Block -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.1*"/>
                            <RowDefinition Height="0.8*"/>
                            <RowDefinition Height="0.1*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status:" FontSize="16" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="0" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,30,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding V3Enabled}" Value="True">
                                            <Setter Property="Foreground" Value="Lime"/>
                                            <Setter Property="Text" Value="On"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding V3Enabled}" Value="False">
                                            <Setter Property="Foreground" Value="Red"/>
                                            <Setter Property="Text" Value="Off"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Rectangle Width="10" Height="10" RadiusX="5" RadiusY="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding V3Enabled}" Value="True">
                                            <Setter Property="Fill" Value="Lime"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding V3Enabled}" Value="False">
                                            <Setter Property="Fill" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <rotaryKnob:RotaryKnob x:Name="V3Knob" Grid.Row="1" MinWidth="150" MinHeight="150" Minimum="0" Maximum="3.3" Value="3.3" IsEnabled="False" ArcColor="Gray" ToolTip="Control disabled. Fixed Supply."/>
                        <Button Command="{Binding ToggleV3V3Command}" Grid.Row="2" Margin="2" Content="Toggle" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" ToolTip="Toggle Supply On/Off."/>
                    </Grid>

                    <!-- Right Block -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="1" Margin="10" Background="#FF474A52" BorderBrush="Snow" MinWidth="40" IsEnabled="False" ToolTip="Control disabled. Fixed Supply.">
                            <Grid>
                                <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="5" MinWidth="25" Fill="Snow"/>
                                <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="25" MinWidth="5" Fill="Snow"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <Slider Grid.Row="2" Height="10" VerticalAlignment="Top" Margin="10" Background="AliceBlue" BorderBrush="Lime" BorderThickness="1" FlowDirection="RightToLeft" Value="{Binding Voltage_Negative, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="3.3" Maximum="3.3" IsEnabled="False"/>
                <TextBox Grid.Row="2" Height="50" VerticalAlignment="Center" Margin="15" FontSize="36" Text="3.300" IsEnabled="False" ToolTip="Control disabled. Fixed Supply."/>
                <CheckBox IsChecked="{Binding plot3V3.VoltageTrace.Visible}" Name="LogVoltage3" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Voltage" Foreground="Snow" Margin="5"/>
                <CheckBox IsChecked="{Binding plot3V3.CurrentTrace.Visible}" Name="LogCurrent3" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Current" Foreground="Snow" Margin="5" HorizontalAlignment="Center"/>
                <CheckBox IsChecked="{Binding plot3V3.PowerTrace.Visible}" Name="LogPower3" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Power" Foreground="Snow" Margin="5" HorizontalAlignment="Right"/>
                <ScottPlot:WpfPlot Name="V3Plot" Grid.Row="3" Margin="5" BorderBrush="Lime" BorderThickness="1"/>
            </Grid>

            <!-- V_2V5 Controls Cell -->
            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition Height="0.5*"/>
                    <RowDefinition Height="0.2*"/>
                    <RowDefinition Height="0.3*"/>
                </Grid.RowDefinitions>
                <Rectangle Fill="#FF474A52"/>
                <TextBlock Text="2V5" Foreground="Snow" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Grid Grid.Row= "1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.2*"/>
                        <ColumnDefinition Width="0.6*" MinWidth="200"/>
                        <ColumnDefinition Width="0.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Block -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.2*"/>
                            <RowDefinition Height="0.4*"/>
                            <RowDefinition Height="0.4*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>

                        <CheckBox Content="Adjust&#10;Limits" Foreground="Snow" VerticalAlignment="Center" Margin="5" IsEnabled="False" ToolTip="Control disabled. Fixed Supply."/>

                        <TextBlock Grid.Row="1" Text="Upper" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <xctk:DoubleUpDown Grid.Row="1" MinHeight="20" MinWidth="60" Minimum="0" Maximum="20" FormatString="F3" Value="0" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False" ToolTip="Control disabled. Fixed Supply."/>

                        <TextBlock Grid.Row="2" Text="Lower" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <xctk:DoubleUpDown Grid.Row="2" MinHeight="20" MinWidth="60" Minimum="0" Maximum="20" FormatString="F3" Value="0" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False" ToolTip="Control disabled. Fixed Supply."/>

                        <Button Grid.Row="3" Margin="10" Background="#FF474A52" BorderBrush="Snow" MinWidth="40" IsEnabled="False" ToolTip="Control disabled. Fixed Supply.">
                            <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="5" MinWidth="25" Fill="Snow"/>
                        </Button>
                    </Grid>

                    <!-- Center Block -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="0.1*"/>
                            <RowDefinition Height="0.8*"/>
                            <RowDefinition Height="0.1*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Status:" FontSize="16" Foreground="Snow" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                        <TextBlock Grid.Row="0" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,5,30,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding V2Enabled}" Value="True">
                                            <Setter Property="Foreground" Value="Lime"/>
                                            <Setter Property="Text" Value="On"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding V2Enabled}" Value="False">
                                            <Setter Property="Foreground" Value="Red"/>
                                            <Setter Property="Text" Value="Off"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Rectangle Width="10" Height="10" RadiusX="5" RadiusY="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0">
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding V2Enabled}" Value="True">
                                            <Setter Property="Fill" Value="Lime"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding V2Enabled}" Value="False">
                                            <Setter Property="Fill" Value="Red"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                        <rotaryKnob:RotaryKnob x:Name="V2Knob" Grid.Row="1" MinWidth="150" MinHeight="150" Minimum="0" Maximum="2.5" Value="2.5" IsEnabled="False" ArcColor="Gray" ToolTip="Control disabled. Fixed Supply."/>
                        <Button Command="{Binding ToggleV2V5Command}" Grid.Row="2" Margin="2" Content="Toggle" FontSize="12" FontWeight="Bold" VerticalContentAlignment="Center" ToolTip="Toggle Supply On/Off." />
                    </Grid>

                    <!-- Right Block -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="0.5*"/>
                        </Grid.RowDefinitions>

                        <Button Grid.Row="1" Margin="10" Background="#FF474A52" BorderBrush="Snow" MinWidth="40" IsEnabled="False" ToolTip="Control disabled. Fixed Supply.">
                            <Grid>
                                <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="5" MinWidth="25" Fill="Snow"/>
                                <Rectangle HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="25" MinWidth="5" Fill="Snow"/>
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>

                <Slider Grid.Row="2" Height="10" VerticalAlignment="Top" Margin="10" Background="AliceBlue" BorderBrush="Lime" BorderThickness="1" FlowDirection="RightToLeft" Value="{Binding Voltage_Negative, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Minimum="3.3" Maximum="3.3" IsEnabled="False"/>
                <TextBox Grid.Row="2" Height="50" VerticalAlignment="Center" Margin="15" FontSize="36" Text="2.500" IsEnabled="False"/>
                <CheckBox IsChecked="{Binding plot2V5.VoltageTrace.Visible}" Name="LogVoltage2" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Voltage" Foreground="Snow" Margin="5"/>
                <CheckBox IsChecked="{Binding plot2V5.CurrentTrace.Visible}" Name="LogCurrent2" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Current" Foreground="Snow" Margin="5" HorizontalAlignment="Center"/>
                <CheckBox IsChecked="{Binding plot2V5.PowerTrace.Visible}" Name="LogPower2" Grid.Row="2" Height="18" VerticalAlignment="Bottom" Content="Log Power" Foreground="Snow" Margin="5" HorizontalAlignment="Right"/>
                <ScottPlot:WpfPlot Name="V2Plot" Grid.Row="3" Margin="5" BorderBrush="Lime" BorderThickness="1"/>
            </Grid>

            <!-- Data Tables for Measurements -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="45"/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <Grid Background="#FF474A52">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <CheckBox Content="Enable Auto Measurements" FontSize="16" Foreground="Snow" VerticalContentAlignment="Center" Margin="5" ToolTip="Automatically collect new data to populate charts and tables." IsChecked="{Binding AutoUpdateChecked}"/>
                    <Button Grid.Column="1" Margin="5" Content="Refresh Measurements" FontSize="16" ToolTip="Collect all measurements and populate charts and tables." Command="{Binding GetUpdate}"/>
                </Grid>
                <DataGrid Grid.Row="1"/>
                <DataGrid Grid.Row="2" ItemsSource="{Binding Measurements}" AutoGenerateColumns="False" ColumnWidth="*" FontSize="20" CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" CanUserResizeColumns="False" CanUserSortColumns="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" />
                        <DataGridTextColumn Header="Voltage" Binding="{Binding Voltage}" />
                        <DataGridTextColumn Header="Current" Binding="{Binding Current}" />
                        <DataGridTextColumn Header="Power" Binding="{Binding Power}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Grid>
        
        <!-- Info panel and Data Logging -->
        <Rectangle Grid.Row="2" Fill="LimeGreen"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.6*"/>
                <ColumnDefinition Width="0.75*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
            <Border Grid.Column="1" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
            <Border Grid.Column="2" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
            <Border Grid.Column="3" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
            <Border Grid.Column="4" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
            
            <Rectangle Grid.Column="0" Fill="LightSlateGray"/>
            <!--VP Graph Buttons-->
            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Background="LimeGreen" Margin="2" Content="Autoscale" ToolTip="Autoscale graph points."/>
                <Button Grid.Column="1" Background="LimeGreen" Margin="2" Content="Pop Out" ToolTip="Pop out graph to new window." Command="{Binding PopOutGraphPositive}"/>
                <Button Grid.Column="2" Background="LimeGreen" Margin="2" Content="Save CSV" ToolTip="Save measurements to CSV file." Command="{Binding SaveVP}"/>
                <Button Grid.Column="3" Background="LimeGreen" Margin="2" Content="Reset" ToolTip="Reset File Path and Clear Data." Command="{Binding ClearGraphPositive}"/>
                <Border Grid.Column="0" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="1" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="2" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="3" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
            </Grid>

            <Rectangle Grid.Column="1" Fill="MediumSeaGreen"/>
            <!--VN Graph Buttons-->
            <Grid Grid.Column="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Background="LimeGreen" Margin="2" Content="Autoscale" ToolTip="Autoscale graph points."/>
                <Button Grid.Column="1" Background="LimeGreen" Margin="2" Content="Pop Out" ToolTip="Pop out graph to new window." Command="{Binding PopOutGraphNegative}"/>
                <Button Grid.Column="2" Background="LimeGreen" Margin="2" Content="Save CSV" ToolTip="Save measurements to CSV file." Command="{Binding SaveVN}"/>
                <Button Grid.Column="3" Background="LimeGreen" Margin="2" Content="Reset" ToolTip="Reset File Path and Clear Data." Command="{Binding ClearGraphNegative}"/>
                <Border Grid.Column="0" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="1" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="2" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="3" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
            </Grid>

            <Rectangle Grid.Column="2" Fill="LightSlateGray"/>
            <!--V3 Graph Buttons-->
            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Background="LimeGreen" Margin="2" Content="Autoscale" ToolTip="Autoscale graph points."/>
                <Button Grid.Column="1" Background="LimeGreen" Margin="2" Content="Pop Out" ToolTip="Pop out graph to new window." Command="{Binding PopOutGraph3V3}"/>
                <Button Grid.Column="2" Background="LimeGreen" Margin="2" Content="Save CSV" ToolTip="Save measurements to CSV file." Command="{Binding SaveV3}"/>
                <Button Grid.Column="3" Background="LimeGreen" Margin="2" Content="Reset" ToolTip="Reset File Path and Clear Data." Command="{Binding ClearGraph3V3}"/>
                <Border Grid.Column="0" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="1" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="2" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="3" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
            </Grid>

            <Rectangle Grid.Column="3" Fill="MediumSeaGreen"/>
            <!--V2 Graph Buttons-->
            <Grid Grid.Column="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Background="LimeGreen" Margin="2" Content="Autoscale" ToolTip="Autoscale graph points."/>
                <Button Grid.Column="1" Background="LimeGreen" Margin="2" Content="Pop Out" ToolTip="Pop out graph to new window." Command="{Binding PopOutGraph2V5}"/>
                <Button Grid.Column="2" Background="LimeGreen" Margin="2" Content="Save CSV" ToolTip="Save measurements to CSV file." Command="{Binding SaveV2}"/>
                <Button Grid.Column="3" Background="LimeGreen" Margin="2" Content="Reset" ToolTip="Reset File Path and Clear Data." Command="{Binding ClearGraph2V5}"/>
                <Border Grid.Column="0" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="1" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="2" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="3" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
            </Grid>

            <Rectangle Grid.Column="4" Fill="LightSlateGray"/>
            <!--System Data Buttons-->
            <Grid Grid.Column="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Background="LimeGreen" Margin="2" Content="Save CSV" ToolTip="Save measurements to CSV file."/>
                <Button Grid.Column="1" Background="LimeGreen" Margin="2" Content="Reset" ToolTip="Reset File Path and Clear Data."/>
                <Border Grid.Column="0" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
                <Border Grid.Column="1" BorderBrush="DarkSlateGray" BorderThickness="1" Margin="2" CornerRadius="5"/>
            </Grid>
        </Grid>
        
    </Grid>
    
</Window>
